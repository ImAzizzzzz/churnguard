# Copy to .env and fill in real values. NEVER commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/churn_db

# JWT signing — use a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# First super-admin, created automatically on startup if absent
FIRST_SUPERADMIN_EMAIL=admin@bank.com
FIRST_SUPERADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Optional — enables the live AI assistant (falls back to canned FAQ if unset)
AI_API_KEY=
